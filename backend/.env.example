PORT=3001
JWT_SECRET=change-me-to-a-strong-random-secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_FULL_NAME=Administrator

# Deploy settings (used by deploy.sh; DEPLOY_USER, DEPLOY_HOST, DEPLOY_PATH are required)
DEPLOY_USER=ubuntu
DEPLOY_HOST=1.2.3.4
DEPLOY_PATH=/home/ubuntu/trailer-handover-api
# Optional: PM2 app name (defaults to trailer-handover-api if unset)
DEPLOY_PM2_APP=trailer-handover-api
